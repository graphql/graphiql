<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GraphiQL 6 with React 19</title>
    <style>
      body {
        margin: 0;
      }

      #graphiql {
        height: 100dvh;
      }

      .loading {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
      }
    </style>
    <link
      rel="stylesheet"
      href="{{GRAPHIQL_CSS_URL}}"
      integrity="{{GRAPHIQL_CSS_INTEGRITY}}"
      crossorigin="anonymous"
    />
    <!-- The Monaco API and language registrations share one bundle. Its scoped
         process alias preserves browser platform detection and keyboard shortcuts. -->
    <!-- cspell:ignoreRegExp /data:text\/javascript,[^"]+/g -->
    <script type="importmap">
{{IMPORTMAP}}
    </script>
    <script type="module">
      import React from 'react';
      import ReactDOM from 'react-dom/client';
      import { GraphiQL } from 'graphiql';
      import { createTransport } from '@graphiql/toolkit';
      import EditorWorker from '{{EditorWorker}}';
      import JsonWorker from '{{JsonWorker}}';
      import GraphQLWorker from '{{GraphQLWorker}}';

      globalThis.MonacoEnvironment = {
        getWorker(_workerId, label) {
          if (label === 'graphql') return new GraphQLWorker();
          if (label === 'json') return new JsonWorker();
          return new EditorWorker();
        },
      };

      const parameters = new URLSearchParams(location.search);
      const transport = createTransport({
        url: parameters.get('endpoint') || 'https://countries.trevorblades.com',
      });

      function App() {
        return React.createElement(GraphiQL, {
          transport,
          initialQuery: parameters.get('query') || undefined,
          defaultEditorToolsVisibility: true,
        });
      }

      const container = document.getElementById('graphiql');
      const root = ReactDOM.createRoot(container);
      root.render(React.createElement(App));
    </script>
  </head>
  <body>
    <div id="graphiql">
      <div class="loading">Loading…</div>
    </div>
  </body>
</html>
