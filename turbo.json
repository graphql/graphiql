{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "yarn.lock",
    "resources/patches/*",
    "resources/tsconfig.base.cjs.json",
    "resources/tsconfig.base.esm.json",
    "resources/patch-monaco-editor-type.mts",
    "scripts/renameFileExtensions.mts"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        // Run `build` in workspaces I depend on first
        "^build"
      ],
      // Cache all files emitted to the packages's directories
      "outputs": ["dist/**", "esm/**", "*.tsbuildinfo"]
    },
    "dev": {
      "dependsOn": [
        // Run `build` in workspaces I depend on first
        "^build"
      ],
      "cache": false
    },
    "types:check": {
      "dependsOn": [
        // Run `build` in workspaces I depend on first
        "^build"
      ],
      "outputs": []
    },
    "test": {}
  }
}
