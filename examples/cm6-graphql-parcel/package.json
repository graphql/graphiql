{
  "name": "example-cm6-graphql-parcel",
  "version": "0.0.0",
  "license": "MIT",
  "description": "GraphiQL Parcel Example",
  "private": true,
  "scripts": {
    "start": "parcel src/index.html -p 8080",
    "build": "parcel build src/index.html --public-url /",
    "build-demo": "pnpm build && node -e \"require('node:fs').cpSync('dist', '../../packages/graphiql/cm6/dist', { recursive: true })\"",
    "types:check": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "cm6-graphql": "^1.0.0",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@types/parcel-env": "^0.0.9",
    "parcel": "^2.16.4",
    "typescript": "^7.0.2"
  }
}
