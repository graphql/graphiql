{
  "name": "graphiql-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "types:check": "tsgo --noEmit",
    "build": "vite build --mode built && node scripts/prepare-dist.mjs",
    "build-demo": "node scripts/build-demo.mjs",
    "dev": "yarn start:source",
    "start:source": "concurrently 'yarn server:source' 'yarn vite:source'",
    "server:source": "cross-env GRAPHIQL_E2E_TARGET=source PORT=8080 node test/e2e-server",
    "server:built": "cross-env GRAPHIQL_E2E_TARGET=built PORT=8080 node test/e2e-server",
    "vite:source": "vite --mode source",
    "cypress:run:source": "cross-env GRAPHIQL_E2E_TARGET=source cypress run",
    "cypress:run:built": "cross-env GRAPHIQL_E2E_TARGET=built cypress run",
    "cypress:open:source": "cross-env GRAPHIQL_E2E_TARGET=source cypress open --browser electron",
    "cypress:a11y:update": "cross-env GRAPHIQL_E2E_TARGET=source CYPRESS_A11Y_UPDATE_BASELINE=1 cypress run --spec cypress/e2e/a11y.cy.ts",
    "cypress-open": "start-server-and-test start:source 'http-get://localhost:8080/graphql?query={test { id }}|http://localhost:5173' cypress:open:source",
    "e2e:source": "start-server-and-test start:source 'http-get://localhost:8080/graphql?query={test { id }}|http://localhost:5173' cypress:run:source",
    "e2e:built": "start-server-and-test server:built http://localhost:8080 cypress:run:built",
    "test:a11y:update": "start-server-and-test start:source 'http-get://localhost:8080/graphql?query={test { id }}|http://localhost:5173' cypress:a11y:update"
  },
  "dependencies": {
    "@graphiql/react": "1.0.0-beta.1",
    "@graphiql/toolkit": "1.0.0-beta.0",
    "graphiql": "6.0.0-beta.1",
    "graphql": "^16.14.2",
    "graphql-ws": "^5.5.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "concurrently": "^7.0.0",
    "cross-env": "^7.0.2",
    "cypress": "^13.13.2",
    "cypress-axe": "^1",
    "cypress-real-events": "^1.15.0",
    "start-server-and-test": "^1.10.11",
    "typescript": "^5.8.0",
    "vite": "^6.4.3"
  }
}
