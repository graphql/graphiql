{
  "name": "graphiql-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "types:check": "tsc --noEmit",
    "build": "pnpm types:check && vite build --mode built && node scripts/prepare-dist.mjs",
    "build-demo": "node scripts/build-demo.mjs",
    "dev": "pnpm start:source",
    "start:source": "concurrently 'pnpm server:source' 'pnpm vite:source'",
    "server:source": "cross-env GRAPHIQL_E2E_TARGET=source PORT=8080 node test/e2e-server",
    "server:built": "cross-env GRAPHIQL_E2E_TARGET=built PORT=8080 node test/e2e-server",
    "vite:source": "vite --mode source",
    "cypress:run:source": "cross-env GRAPHIQL_E2E_TARGET=source cypress run --browser chrome",
    "cypress:run:built": "cross-env GRAPHIQL_E2E_TARGET=built cypress run --browser chrome",
    "cypress:open:source": "cross-env GRAPHIQL_E2E_TARGET=source cypress open --browser chrome",
    "cypress:a11y:update": "cross-env GRAPHIQL_E2E_TARGET=source CYPRESS_A11Y_UPDATE_BASELINE=1 cypress run --browser chrome --spec cypress/e2e/a11y.cy.ts",
    "cypress-open": "start-server-and-test start:source 'http-get://localhost:8080/graphql?query={test { id }}|http://localhost:5173' cypress:open:source",
    "e2e:source": "start-server-and-test start:source 'http-get://localhost:8080/graphql?query={test { id }}|http://localhost:5173' cypress:run:source",
    "e2e:built": "start-server-and-test server:built http://localhost:8080 cypress:run:built",
    "test:a11y:update": "start-server-and-test start:source 'http-get://localhost:8080/graphql?query={test { id }}|http://localhost:5173' cypress:a11y:update"
  },
  "dependencies": {
    "@graphiql/react": "1.0.0",
    "@graphiql/toolkit": "1.0.0",
    "graphiql": "6.0.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cypress": "^16.0.0",
    "cypress-axe": "^1",
    "cypress-each": "^1.14.1",
    "cypress-real-events": "^1.15.1",
    "start-server-and-test": "^1.15.5",
    "typescript": "^5.8.0",
    "vite": "^8.2.2"
  }
}
