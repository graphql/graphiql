{
  "name": "@graphiql/plugin-code-exporter",
  "version": "6.0.0",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/graphql/graphiql",
    "directory": "packages/graphiql-plugin-code-exporter"
  },
  "author": "LekoArts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "keywords": [
    "react",
    "graphql",
    "graphiql",
    "plugin",
    "explorer"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    ".": "./dist/index.js"
  },
  "scripts": {
    "types:check": "tsc --noEmit",
    "dev": "vite build --watch --emptyOutDir=false",
    "build": "pnpm types:check && vite build && pnpm postbuild",
    "postbuild": "cp src/graphiql-code-exporter.d.ts dist/graphiql-code-exporter.d.ts"
  },
  "dependencies": {
    "graphiql-code-exporter": "^3.0.3"
  },
  "peerDependencies": {
    "@graphiql/react": "^1.0.0",
    "graphql": "^16.11.0 || ^17.0.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@graphiql/react": "^1.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitejs/plugin-react": "^5.2.0",
    "graphql": "^17.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.4",
    "vite-plugin-dts": "^4.0.1"
  }
}
