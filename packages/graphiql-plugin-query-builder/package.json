{
  "name": "@graphiql/plugin-query-builder",
  "version": "1.0.1",
  "sideEffects": [
    "*.css"
  ],
  "description": "A first-party visual query builder plugin for GraphiQL.",
  "repository": {
    "type": "git",
    "url": "https://github.com/graphql/graphiql",
    "directory": "packages/graphiql-plugin-query-builder"
  },
  "homepage": "https://github.com/graphql/graphiql/tree/master/packages/graphiql-plugin-query-builder#readme",
  "bugs": {
    "url": "https://github.com/graphql/graphiql/issues?q=issue+label:@graphiql/plugin-query-builder"
  },
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "keywords": [
    "react",
    "graphql",
    "graphiql",
    "plugin",
    "query",
    "builder"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "types:check": "tsc --noEmit",
    "dev": "vite build --watch --emptyOutDir=false",
    "build": "pnpm types:check && vite build",
    "test": "vitest run",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@graphiql/react": "^1.0.1",
    "graphql": "^16.11.0 || ^17.0.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "react-compiler-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@graphiql/react": "^1.0.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "graphql": "^17.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.6.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@rolldown/plugin-babel": "^0.2.4"
  }
