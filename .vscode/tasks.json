{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch-vscode",
      "type": "npm",
      "script": "watch-vscode",
      "problemMatcher": {
        "base": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "bundling vscode-graphql$",
          "endsPattern": "successfully bundled vscode-graphql 🚀"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "watch-vscode-exec",
      "type": "npm",
      "script": "watch-vscode-exec",
      "problemMatcher": {
        "base": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "bundling vscode-graphql-execution$",
          "endsPattern": "successfully bundled vscode-graphql-execution 🚀"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
