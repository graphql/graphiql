{
  "name": "graphiql-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "check:lockfile": "node scripts/check-pnpm-lockfile.mts",
    "types:check": "turbo run types:check && tsgo --noEmit -p scripts/tsconfig.json",
    "dev:graphiql": "turbo watch dev --filter=graphiql",
    "dev:example-nextjs": "turbo run dev --filter=example-graphiql-nextjs...",
    "dev:example-vite": "turbo watch dev --filter=example-graphiql-vite",
    "build:graphiql": "turbo run build --filter=graphiql...",
    "build": "turbo run build --filter='!example-monaco-graphql-*' --filter='!example-graphiql-webpack'",
    "build-bundles": "turbo run build-bundles --filter=vscode-graphql --filter=vscode-graphql-execution",
    "build-bundles-clean": "node scripts/clean.mts --bundles",
    "build-clean": "pnpm build:clean",
    "build-docs": "rimraf packages/graphiql/typedoc && typedoc",
    "build:clean": "node scripts/clean.mts",
    "build:rebuild": "pnpm build:clean && pnpm build",
    "build:watch": "turbo watch build --filter='!example-monaco-graphql-*' --filter='!example-graphiql-webpack'",
    "build-demo": "turbo run build-demo --filter=example-graphiql-webpack --filter=example-monaco-graphql-webpack",
    "watch": "pnpm build:watch",
    "watch-vscode": "turbo watch build-bundles --filter=vscode-graphql... --output-logs=full --log-order=stream --no-color",
    "watch-vscode-exec": "turbo watch build-bundles --filter=vscode-graphql-execution... --output-logs=full --log-order=stream --no-color",
    "cypress-open": "concurrently 'pnpm dev:graphiql' 'pnpm --filter graphiql cypress-open'",
    "e2e": "pnpm --filter graphiql e2e",
    "oxlint": "oxlint --max-warnings=0 --ignore-path .eslintignore",
    "fix": "pnpm lint-fix && pnpm format && pnpm svgo",
    "license-check": "jsgl --local .",
    "lint": "pnpm oxlint && pnpm format-check && pnpm lint-cspell",
    "lint-cspell": "cspell --unique --no-progress --no-must-find-files",
    "lint-fix": "pnpm oxlint --fix",
    "prebuild-bundles": "pnpm build-bundles-clean",
    "prepublishOnly": "./scripts/prepublish.sh",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check .",
    "svgo": "svgo --pretty --indent 2 --eol lf --final-newline -r -f . --exclude node_modules",
    "svgo-check": "pnpm svgo && git diff --exit-code -- '*.svg'",
    "ci:version": "pnpm changeset version && pnpm install --no-frozen-lockfile && pnpm build && pnpm fix",
    "release": "pnpm build && pnpm build-bundles && pnpm changeset publish",
    "repo:lint": "manypkg check",
    "repo:fix": "manypkg fix",
    "repo:resolve": "node scripts/set-resolution.mts",
    "t": "pnpm test",
    "test": "turbo run test --filter='./packages/*'",
    "gen-agenda": "wgutils agenda gen"
  },
  "dependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-private-methods": "^7.24.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/register": "^7.21.0",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.27.7",
    "@types/codemirror": "^0.0.90",
    "@types/copy": "^0.3.1",
    "@types/express": "^4.17.11",
    "@types/mkdirp": "1.0.2",
    "@types/node": "^24",
    "@types/rimraf": "^3.0.2",
    "@types/ws": "8.2.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "concurrently": "^7.0.0",
    "copy": "^0.3.2",
    "cspell": "^10.0.1",
    "eslint-plugin-react-hooks": "^6.0.0-rc.1",
    "execa": "^7.1.1",
    "js-green-licenses": "4.0.0",
    "mkdirp": "^1.0.4",
    "msw": "^2.13.4",
    "oxfmt": "^0.45.0",
    "oxlint": "^1",
    "oxlint-plugin-eslint": "^1",
    "oxlint-tsgolint": "latest",
    "rimraf": "^3.0.2",
    "turbo": "^2.9.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "wgutils": "^1.2.5"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.1-2",
    "jsdom": "^29.0.2",
    "ovsx": "0.8.3",
    "svgo": "^4.1.0"
  }
}
